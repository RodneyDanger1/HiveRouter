{
  "name": "hive-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HiveRouter - local-first, truth-first AI code generation router",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run typecheck && vite build --config web/vite.config.ts",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "preflight": "tsx scripts/preflight.ts",
    "stub-sweep": "node scripts/stub-sweep.mjs",
    "secret-scan": "node scripts/check-secrets.mjs",
    "assert-stage": "node scripts/assert-stage.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run stub-sweep && npm run secret-scan",
    "bench": "tsx scripts/bench-suite.ts",
    "eval:router": "tsx scripts/eval-router.ts",
    "replay": "tsx scripts/replay-run.ts",
    "repo-map": "tsx scripts/build-repo-map.ts",
    "context:report": "tsx scripts/context-pack-report.ts",
    "integrity": "tsx scripts/integrity-check.ts",
    "learn": "tsx scripts/learn.ts",
    "learning:admin": "tsx scripts/learning-admin.ts",
    "test:live": "tsx scripts/live-smoke.ts",
    "key:import": "tsx scripts/key-import.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.2",
    "@fontsource/instrument-serif": "5.3.0",
    "diff": "9.0.0",
    "fastify": "5.12.8",
    "fflate": "0.8.3",
    "lucide-react": "1.67.0",
    "p-limit": "7.3.3",
    "parse5": "8.1.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.5",
    "remark-gfm": "4.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "pino-pretty": "13.2.0",
    "tailwindcss": "4.3.4",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
